# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Reference repositories (cloned for reading, not part of this project)
TeamsLingo/
WhisprRT/

# Whisper model cache
models/
*.pt
*.bin

# Captured transcripts / audio
transcripts/
recordings/
captions.next.*

# 标定用音频素材：第三方内容（公开致辞、付费课程），且体积大。
# 标定报告只需引用文件名，可复现性对本地足够，不进仓库。
sample/

# Git worktrees (isolated workspaces)
.worktrees/

# SDD 工作区（进度账本、任务简报、报告、评审包）
.superpowers/

# 凭据：本地放着的密钥文件。仓库是公开的，密钥一旦提交就进了历史，
# 删掉也还在 —— 所以宁可在这里挡一道。
密钥.txt
*.key
*.secret
.env

# 「装成应用」时生成的快捷方式：里面写的是本机绝对路径（解释器、仓库位置），
# 换台机器就是废的 —— 和密钥同理，不该进仓库。仓库根现在躺着一个，挡掉。
*.lnk
